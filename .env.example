# Environment Variables Template
# Copy this file to .env.local and fill in your values

# MongoDB Atlas Connection String
# Get from: https://www.mongodb.com/cloud/atlas → Cluster → Connect → Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Lumina

# JWT Secret for token signing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-very-secure-random-string-here-min-32-chars

# Cloudinary API Key
# Get from: https://cloudinary.com → Dashboard → Settings → API Keys
CLOUDINARY_API_KEY=321544585999788

# Cloudinary API Secret
# Get from: https://cloudinary.com → Dashboard → Settings → API Keys
CLOUDINARY_API_SECRET=8qgY-reDD-fRbW2LUwiV5afaysU

# Optional: Node environment
NODE_ENV=development

# Optional: API timeout (milliseconds)
API_TIMEOUT=30000




