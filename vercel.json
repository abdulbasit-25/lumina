{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install && pip install -r requirements.txt",

  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    },
    "api/ai/*.py": {
      "runtime": "python3.9"
    }
  },

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
